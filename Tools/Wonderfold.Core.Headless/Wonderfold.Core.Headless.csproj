<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the exact same source files Unity compiles into the Wonderfold.Core assembly.
    Targeting netstandard2.1 with LangVersion 9 keeps us honest: anything that builds here
    is guaranteed to build inside Unity 6 as well.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>Wonderfold.Core</AssemblyName>
    <RootNamespace>Wonderfold.Core</RootNamespace>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" LinkBase="Core" />
  </ItemGroup>

</Project>
