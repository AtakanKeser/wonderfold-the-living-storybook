<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the same NUnit tests Unity's Edit Mode Test Runner runs, but headlessly via `dotnet test`.
    Source of truth for the test files is Assets/Tests/EditMode so there is exactly one copy.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>Wonderfold.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Tests/EditMode/**/*.cs" LinkBase="EditMode" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Wonderfold.Core.Headless/Wonderfold.Core.Headless.csproj" />
  </ItemGroup>

</Project>
