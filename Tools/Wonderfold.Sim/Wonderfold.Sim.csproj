<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless level laboratory. Runs thousands of seeded playthroughs per level with bot agents,
    prints balance reports, and can play a level in the terminal for hands-on debugging.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>wonderfold-sim</AssemblyName>
    <RootNamespace>Wonderfold.Sim</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Wonderfold.Core.Headless/Wonderfold.Core.Headless.csproj" />
  </ItemGroup>

</Project>
